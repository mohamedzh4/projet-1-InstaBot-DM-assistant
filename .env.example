# Copy to .dev.vars for `wrangler dev` (never commit real values).

# Public URL of this worker, no trailing slash.
# Local: https://instabot.<your-subdomain>.workers.dev  (after first deploy)
# Or a tunnel URL while testing.
PUBLIC_URL="https://instabot.example.workers.dev"

# Instagram / Meta
IG_VERIFY_TOKEN="choose-a-long-random-verify-token"
IG_APP_SECRET=""
IG_ACCESS_TOKEN=""
# Optional. Default: https://graph.instagram.com/v21.0/me/messages
IG_GRAPH_MESSAGES_URL="https://graph.instagram.com/v21.0/me/messages"
BOT_NAME="instabot"

# 64 hex chars = 32 bytes. Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# Shared free AI (at least one). Users can add their own key on the optional page.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Growth credits (Instagram can only detect some actions — see README)
CREDIT_STORY_REPLY="2"
CREDIT_STORY_MENTION="4"
CREDIT_COMMENT="2"
CREDIT_MENTION="3"
CREDIT_INVITE="5"
CREDIT_AI_TEXT="1"
CREDIT_AI_MEDIA="2"
CREDIT_BRAIN_MIN="1"
# First DM bonus. Use 0 in production if they must earn from growth first.
CREDIT_WELCOME="0"

# Optional Notion OAuth (public integration). Leave empty to hide Notion on the page.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Local-only fake inbox. Never set true in production.
ALLOW_DEV_INBOX="false"
DEV_INBOX_SECRET=""
