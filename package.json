{
  "name": "instabot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "local": "node scripts/init-local.mjs && wrangler d1 migrations apply instabot --local && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply instabot --local",
    "db:migrate:remote": "wrangler d1 migrations apply instabot --remote",
    "db:create": "wrangler d1 create instabot",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.34.0"
  }
}
